/* ==========================================================
   PANELS
========================================================== */

.panel-title {
    text-style: bold;
    text-align: left;
    color: $primary;
    margin-bottom: 1;
}

.panel-content {
    content-align: left top;
    text-align: left;
    height: 1fr;
    color: $text;
}

/* ==========================================================
   HEADER
========================================================== */

DeepHeader {
    height: 2;
    layout: horizontal;

    background: $surface;
    color: $text;

    padding: 0 2;

    border-bottom: solid $border;
}

#header-logo {
    width: 18;

    color: $primary;

    text-style: bold;
}

#header-status {
    width: 1fr;

    color: $text-muted;

    content-align: center middle;
}

#header-online {
    width: 12;

    color: $success;

    text-style: bold;

    text-align: right;
}

/* ==========================================================
   FOOTER
========================================================== */

#deep-footer {
    dock: bottom;
    height: 1;

    background: #16111D;
    color: #B9B2C9;

    text-style: bold;

    padding: 0 2;
}

/* ==========================================================
   BOOT SCREEN
========================================================== */

Screen {
    align: center middle;
}

#boot-log {
    width: 60;
    height: auto;

    padding: 1 2;

    background: transparent;
    border: none;

    color: $text;

    content-align: center middle;
    text-align: center;
    scrollbar-size: 0 0;
}

/* ==========================================================
   NAVIGATION
========================================================== */

#navigation {
    margin-top: 2;

    text-align: left;

    text-style: bold;

    color: $primary;
}

/* ==========================================================
   SCREEN TITLE
========================================================== */

#screen-title {
    width: 100%;

    height: 1fr;

    content-align: center middle;

    text-style: bold;

    color: $primary;
}

/* ==========================================================
   HOME SCREEN
========================================================== */

#speed-banner {
    color: $secondary;

    text-align: left;

    margin-top: 1;

    margin-bottom: 1;
}

#tagline {
    color: $text-muted;

    text-align: center;
}

ProjectCard {
    width: 92%;
    height: auto;

    margin: 1 4;
    padding: 1 2;

    border: round #352846;
    background: #16111D;
}

ProjectCard:focus {
    border: round #F472B6;
    background: #21182C;
}

.project-title {
    margin-bottom: 1;
}

.project-description {
    color: #F8F7FC;
    margin-bottom: 1;
}

.project-tech {
    color: #3f75da;
    margin-bottom: 1;
}

.project-link {
    color: #C084FC;
    text-style: bold;
}

.experience-card {
    border: round #352846;
    background: #16111D;

    padding: 1 2;
    margin: 1 4;

    color: #F8F7FC;
}

#connect-list {
    width: 60;
    height: auto;

    margin: 2 0;
    padding: 0 1;

    border: none;
    background: transparent;
}

#connect-list > ListItem {
    padding: 1 2;
    margin: 0 0 1 0;

    border: none;
    background: transparent;
}

.social-link {
    height: auto;
    padding: 1 2;

    layout: horizontal;
    align: left middle;
}

.social-icon {
    width: 3;

    content-align: center middle;

    color: $secondary;
    text-style: bold;

    transition: color 200ms;
}

.social-label {
    width: 1fr;

    margin-left: 1;

    color: $text;

    transition: color 200ms;
}

/* Focused item */

SocialLinkItem:focus .social-icon {
    color: #3f75da;
}

SocialLinkItem:focus .social-label {
    color: #3f75da;
    text-style: bold;
}