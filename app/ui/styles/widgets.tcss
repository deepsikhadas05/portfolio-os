/* ==========================================================
   PANELS
========================================================== */

.panel-title {
    text-style: bold;
    text-align: left;
    color: $primary;
    margin-bottom: 1;
}

.panel-content {
    content-align: left top;
    text-align: left;
    height: 1fr;
    color: $text;
}

/* ==========================================================
   HEADER
========================================================== */

DeepHeader {
    height: 2;
    layout: horizontal;

    background: $surface;
    color: $text;

    padding: 0 2;

    border-bottom: solid $border;
}

#header-logo {
    width: 18;

    color: $primary;

    text-style: bold;
}

#header-status {
    width: 1fr;

    color: $text-muted;

    content-align: center middle;
}

#header-online {
    width: 12;

    color: $success;

    text-style: bold;

    text-align: right;
}

/* ==========================================================
   FOOTER
========================================================== */

#deep-footer {
    dock: bottom;
    height: 1;

    background: #16111D;
    color: #B9B2C9;

    text-style: bold;

    padding: 0 2;
}

/* ==========================================================
   BOOT SCREEN
========================================================== */

#boot-text {
    width: 100%;

    text-align: center;

    color: $secondary;

    content-align: center middle;

    text-style: bold;
}

#boot-log {
    width: 100%;
    height: 100%;

    padding: 2 4;

    background: $surface;
    color: $text;
}

/* ==========================================================
   NAVIGATION
========================================================== */

#navigation {
    margin-top: 2;

    text-align: left;

    text-style: bold;

    color: $primary;
}

/* ==========================================================
   SCREEN TITLE
========================================================== */

#screen-title {
    width: 100%;

    height: 1fr;

    content-align: center middle;

    text-style: bold;

    color: $primary;
}

/* ==========================================================
   HOME SCREEN
========================================================== */

#speed-banner {
    color: $secondary;

    text-align: left;

    margin-top: 1;

    margin-bottom: 1;
}

#tagline {
    color: $text-muted;

    text-align: center;
}