Screen {
    layout: vertical;
}

#body {
    height: 1fr;
}

#left-panel {
    width: 60%;
    margin: 1;
    padding: 2 2;
}

#right-panel {
    width: 40%;
    margin: 1 1 1 0;
    padding: 2 2;
}

#portrait {

    color: white;

    width: 100%;

    height: auto;

    text-align: left;

    content-align: left top;

    margin-bottom: 1;
}

#profile-info {

    color: $text-muted;

    text-align: center;

    margin-top: 1;
}

StarField {

    layer: background;

    width: 100%;

    height: 100%;

    color: white;

    opacity: 70%;

    content-align: left top;

    padding: 0;

    margin: 0;
}